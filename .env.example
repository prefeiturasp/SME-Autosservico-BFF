# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# Não coloque aqui hosts internos, portas reais de produção ou segredos
# verdadeiros — apenas placeholders descritivos.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=sua-chave-secreta-aqui
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Autenticação por chave de API (serviço-a-serviço)
API_KEY=sua-chave-de-api-aqui
API_KEY_HEADER=X-Api-Key

# KeyDB (BFF_BROKER): broker do Celery e cache de estado da UI.
# "keydb" é o nome do serviço no docker-compose, não um host de produção.
CELERY_BROKER_URL=redis://keydb:6379/0
CELERY_RESULT_BACKEND=redis://keydb:6379/0
KEYDB_CACHE_URL=redis://keydb:6379/1

# Zabbix (status de disponibilidade, banco de dados, builds do Jenkins)
ZABBIX_API_URL=http://zabbix-exemplo/api_jsonrpc.php
ZABBIX_API_TOKEN=seu-token-zabbix-aqui
ZABBIX_DEFAULT_HOST=Zabbix server
ZABBIX_RECENT_WINDOW_MS=86400000
ZABBIX_HTTP_TIMEOUT=10
ZABBIX_CACHE_TTL_STATUS_SECONDS=60
ZABBIX_CACHE_TTL_JENKINS_SECONDS=90
ZABBIX_CACHE_TTL_DATABASE_SECONDS=180
ZABBIX_DATABASE_BEAT_INTERVAL_SECONDS=90
ZABBIX_LOCK_TTL_SECONDS=30

# Variáveis usadas apenas fora de DEBUG (produção)
# CSRF_TRUSTED_ORIGINS=https://dominio-do-frontend-em-producao
